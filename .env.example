# Copy this file to ".env" and fill in your real values.
# ".env" itself is git-ignored — it will never be pushed to GitHub.
# On Render, you won't use this file at all — you'll set these same
# names directly in the service's "Environment" tab instead.

CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
